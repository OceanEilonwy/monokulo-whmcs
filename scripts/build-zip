#!/usr/bin/env php
<?php
/**
 * Builds dist/monokulo-whmcs.zip (and its .sha256) from src/: a `modules/`
 * folder to upload into the WHMCS root, as WHMCS's third-party gateways are
 * installed.
 *
 * Entries are sorted and dated 2026-01-01, so the same source always gives
 * the same zip.
 */
$root = dirname(__DIR__);
$src = $root . '/src';
$dist = $root . '/dist';
$name = 'monokulo-whmcs.zip';
$zipPath = $dist . '/' . $name;

if (!is_dir($dist)) {
	mkdir($dist);
}
@unlink($zipPath);

$files = [];
$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
	if ($file->isFile()) {
		$files[] = substr($file->getPathname(), strlen($src) + 1);
	}
}
sort($files, SORT_STRING);

$zip = new ZipArchive();
if ($zip->open($zipPath, ZipArchive::CREATE | ZipArchive::EXCL) !== true) {
	fwrite(STDERR, "cannot create $zipPath\n");
	exit(1);
}
$time = gmmktime(0, 0, 0, 1, 1, 2026);
foreach ($files as $file) {
	$zip->addFile($src . '/' . $file, $file);
	$zip->setMtimeName($file, $time);
	$zip->setCompressionName($file, ZipArchive::CM_DEFLATE);
	$zip->setExternalAttributesName($file, ZipArchive::OPSYS_UNIX, 0100644 << 16);
}
$zip->close();

$hash = hash_file('sha256', $zipPath);
file_put_contents($zipPath . '.sha256', $hash . '  ' . $name . "\n");
printf("dist/%s (%s, %d files): %s\n", $name, trim((string)file_get_contents($root . '/VERSION')), count($files), $hash);
