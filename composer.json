{
    "name": "monokulo/whmcs",
    "description": "Monokulo payment gateway for WHMCS: take Monero through your own self-hosted Monokulo. This file is for the gateway's tests only: the gateway has no runtime dependencies beyond WHMCS.",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "illuminate/database": "^10.48",
        "phpunit/phpcov": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Monokulo\\Whmcs\\Tests\\": "tests/",
            "WHMCS\\": "tests/whmcs/lib/WHMCS/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
