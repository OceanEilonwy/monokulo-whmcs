<?xml version="1.0" encoding="UTF-8"?>
<!--
    The gateway's tests, in four suites:

    - unit:     the library, no WHMCS (runs anywhere)
    - module:   the gateway's functions and callback in-process, against the
                stand-in WHMCS (tests/whmcs) and its MariaDB
    - http:     real HTTP to the stand-in WHMCS's web server, through the
                callback file itself (names say over_http)
    - smoke:    against a real Monokulo (MONOKULO_URL), optional

    scripts/test runs them.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    executionOrder="defects"
    failOnWarning="true"
    failOnNotice="true"
    failOnDeprecation="true"
    failOnRisky="true"
    beStrictAboutOutputDuringTests="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnTestsThatTriggerNotices="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="module">
            <directory>tests/Module</directory>
        </testsuite>
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <source restrictDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
